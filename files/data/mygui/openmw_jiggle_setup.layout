<?xml version="1.0" encoding="UTF-8"?>
<MyGUI type="Layout" version="3.2.0">
    <Widget type="Window" skin="MW_Window" position="80 60 570 505" layer="Settings" name="_Main">
        <Property key="Caption" value="Advanced Jiggle Setup"/>
        <Property key="MinSize" value="520 450"/>
        <Widget type="EditBox" skin="SandText" position="12 8 540 36">
            <Property key="MultiLine" value="true"/>
            <Property key="WordWrap" value="true"/>
            <Property key="Static" value="true"/>
            <Property key="TextAlign" value="Left Top"/>
            <Property key="Caption" value="Per-mesh tuning, the NPC list and glute physics."/>
        </Widget>
        <Widget type="TabControl" skin="TabControl" position="12 48 546 376" align="Stretch" name="JiggleSetupTabs">
            <Property key="ButtonAutoWidth" value="true"/>

            <Widget type="TabItem">
                <Property key="Caption" value=" Quick Setup "/>
                <Widget type="EditBox" skin="SandText" position="8 10 510 54">
                    <Property key="MultiLine" value="true"/>
                    <Property key="WordWrap" value="true"/>
                    <Property key="Static" value="true"/>
                    <Property key="TextAlign" value="Left Top"/>
                    <Property key="Caption" value="Equip the body/clothing/armor you want, tune the Jiggle sliders, then click Add. Changes apply at once."/>
                </Widget>
                <Widget type="TextBox" skin="NormalText" position="8 72 510 70" name="JiggleQuickCurrentInfo">
                    <Property key="Caption" value="Current outfit: not detected"/>
                    <Property key="TextAlign" value="Left Top"/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" position="8 154 510 30" name="JiggleQuickAddAnyButton">
                    <Property key="Caption" value="Add Current Outfit to Jiggle"/>
                    <UserString key="ToolTipType" value="Layout"/>
                    <UserString key="ToolTipLayout" value="TextToolTip"/>
                    <UserString key="Caption_Text" value="Turns on body Jiggle/auto-rig, removes blacklist entries blocking the currently worn mesh, and saves the current live breast/butt offsets for this mesh."/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" position="8 192 510 30" name="JiggleQuickAddPlayerButton">
                    <Property key="Caption" value="Save Current Outfit Tuning for Player Only"/>
                    <UserString key="ToolTipType" value="Layout"/>
                    <UserString key="ToolTipLayout" value="TextToolTip"/>
                    <UserString key="Caption_Text" value="Adds the current outfit to Jiggle and stores its current live breast/butt offsets specifically for the player."/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" position="8 238 245 30" name="JiggleQuickBlacklistButton">
                    <Property key="Caption" value="Exclude Current Outfit"/>
                    <UserString key="ToolTipType" value="Layout"/>
                    <UserString key="ToolTipLayout" value="TextToolTip"/>
                    <UserString key="Caption_Text" value="Adds the currently worn mesh to the auto-rig blacklist. Applies at once."/>
                </Widget>
                <Widget type="AutoSizedButton" skin="MW_Button" position="273 238 245 30" name="JiggleQuickClearButton">
                    <Property key="Caption" value="Remove Saved Tuning"/>
                    <UserString key="ToolTipType" value="Layout"/>
                    <UserString key="ToolTipLayout" value="TextToolTip"/>
                    <UserString key="Caption_Text" value="Removes Any Actor and Player-only saved Z-offset tuning for the currently worn mesh. It does not blacklist the mesh."/>
                </Widget>
                <Widget type="EditBox" skin="SandText" position="8 282 510 54">
                    <Property key="MultiLine" value="true"/>
                    <Property key="WordWrap" value="true"/>
                    <Property key="Static" value="true"/>
                    <Property key="TextAlign" value="Left Top"/>
                    <Property key="Caption" value="Tip: Add Current Outfit is the normal one-click choice."/>
                </Widget>
            </Widget>

            <Widget type="TabItem">
                <Property key="Caption" value=" Z Offsets "/>
                <Widget type="AutoSizedTextBox" skin="NormalText" position="8 10 510 18">
