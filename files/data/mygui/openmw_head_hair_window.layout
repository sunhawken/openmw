<?xml version="1.0" encoding="UTF-8"?>

<MyGUI type="Layout">
    <Widget type="Window" skin="MW_Window" layer="Windows" position="0 0 320 150" name="_Main">
        <Property key="MinSize" value="220 120"/>
        <Property key="Caption" value="#{OMWEngine:AppearanceTitle}"/>

        <!-- Head -->
        <Widget type="TextBox" skin="NormalText" position="12 30 296 18" align="Left Top HStretch" name="HeadLabel">
            <Property key="Caption" value="#{OMWEngine:AppearanceHead}"/>
        </Widget>
        <Widget type="ScrollBar" skin="MW_HScroll" position="12 50 296 18" align="Left Top HStretch" name="HeadSlider">
            <Property key="Range" value="1"/>
            <Property key="Page" value="1"/>
        </Widget>

        <!-- Hair -->
        <Widget type="TextBox" skin="NormalText" position="12 78 296 18" align="Left Top HStretch" name="HairLabel">
            <Property key="Caption" value="#{OMWEngine:AppearanceHair}"/>
        </Widget>
        <Widget type="ScrollBar" skin="MW_HScroll" position="12 98 296 18" align="Left Top HStretch" name="HairSlider">
            <Property key="Range" value="1"/>
            <Property key="Page" value="1"/>
        </Widget>
    </Widget>
</MyGUI>
